# app/api/randevu/route.ts bu üç değişkeni kullanır.
# Üçü de yoksa istek yine doğrulanır ve 200 döner, e-posta gönderilmez —
# yani form sessizce başarılı görünür ama kimseye ulaşmaz.
# Canlıya almadan önce Vercel > Settings > Environment Variables'a girilmeli.

# resend.com > API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Randevu taleplerinin düşeceği adres
ALICI_EPOSTA=info@klinigin.com

# Resend'de doğrulanmış gönderen adresi
GONDEREN_EPOSTA=randevu@klinigin.com
