# Randevu formunun çalışması için gereken değerler.
#
# Bu dosya örnektir ve depoya girer — GERÇEK DEĞER YAZMAYIN.
# Kendi değerlerinizi `.env.local` dosyasına yazın; o dosya .gitignore'da.
#
# Vercel'e yüklerken aynı değerler proje ayarlarındaki
# Settings → Environment Variables bölümüne girilir.

# resend.com → API Keys bölümünden alınır. "re_" ile başlar.
RESEND_API_KEY=re_buraya_kendi_anahtariniz

# Randevu taleplerinin düşeceği e-posta adresi.
# Resend'de alan adı doğrulanmadan YALNIZCA hesabı açtığınız adrese gönderim yapılabilir.
RANDEVU_ALICI=sizin@epostaniz.com

# Gönderen adresi. Alan adı doğrulanana kadar Resend'in test adresi kullanılır.
# Kendi alan adınızı doğruladıktan sonra: Randevu <randevu@alanadiniz.com>
RANDEVU_GONDEREN=Randevu <onboarding@resend.dev>
